# Local dev: leave empty — Vite's dev server proxies /api/* to the backend
# (see vite.config.ts), so relative requests just work.
#
# Production (Vercel): the frontend and backend are deployed as two
# separate Vercel projects on different domains, so this must point at the
# backend project's URL, e.g.:
# VITE_API_BASE_URL=https://revenue-expense-tracker-api.vercel.app
VITE_API_BASE_URL=
