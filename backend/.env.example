# --- Database -----------------------------------------------------------
# Local development option A (simplest, no external services): SQLite.
# Temporarily set `provider = "sqlite"` in prisma/schema.prisma and use:
# DATABASE_URL="file:./dev.db"

# Local development option B / Production: PostgreSQL via Neon
# (https://neon.tech — Vercel's recommended serverless Postgres provider).
# Create a project, then copy both connection strings it gives you:
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/revenue_expense_tracker?sslmode=require"
# The *unpooled* connection string — used only for running migrations.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/revenue_expense_tracker?sslmode=require"

# --- Auth ---------------------------------------------------------------
# Generate a real secret for production, e.g. `openssl rand -base64 48`
JWT_SECRET="replace-with-a-long-random-secret"

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Restrict CORS to your deployed frontend's origin in production, e.g.
# CORS_ORIGIN="https://revenue-expense-tracker.vercel.app"
# Defaults to "*" (safe here since auth uses bearer tokens, not cookies).
CORS_ORIGIN=

# --- File storage ---------------------------------------------------------
# Local dev: not needed unless you want to test uploads — documents.ts
# always uses Vercel Blob (see below).
# Production (Vercel): create a Blob store under your project's Storage tab;
# Vercel injects BLOB_READ_WRITE_TOKEN automatically when it's linked, so
# you typically don't need to set this yourself except for local testing
# against a real Blob store.
BLOB_READ_WRITE_TOKEN=
