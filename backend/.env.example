# --- Database ---------------------------------------------------------------
# Dev/demo: SQLite, no external services required.
DATABASE_URL="file:./dev.db"

# Production: point at a real Postgres instance and change
# `provider = "sqlite"` to `provider = "postgresql"` in prisma/schema.prisma.
# DATABASE_URL="postgresql://user:password@localhost:5432/revenue_expense_tracker"

# --- Auth ---------------------------------------------------------------------
# Generate a real secret for production, e.g. `openssl rand -base64 48`
JWT_SECRET="replace-with-a-long-random-secret"

# --- Server ---------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Directory for uploaded receipts/documents (dev only — use S3/Blob storage in production)
UPLOAD_DIR=./uploads
